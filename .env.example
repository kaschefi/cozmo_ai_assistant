# ==============================================================================
# MoKa AI Assistant - Environment Configuration
# ==============================================================================

# --- Security & Authentication (Required for Cloud Whitelist) ---
MOKA_ADMIN_TOKEN=generate_a_strong_random_secret_here
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cozmo_memory
DATABASE_URL=postgresql://postgres:your_secure_password_here@database:5432/cozmo_memory

# --- LLM Provider Selection: 'OLLAMA' (local) or 'AZURE' (cloud) ---
LLM_PROVIDER=AZURE

# --- Azure AI / Azure OpenAI (Used when LLM_PROVIDER=AZURE) ---
AZURE_SERVICES_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/openai/v1
AZURE_API_KEY=your_azure_api_key_here
AZURE_MODEL_NAME=Phi-4-mini-instruct
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Local Ollama Configuration (Used when LLM_PROVIDER=OLLAMA) ---
OLLAMA_BASE_URL=http://localhost:11434
ROUTER_LLM_MODEL=qwen2.5:3b
CHAT_LLM_MODEL=qwen2.5:3b
WEATHER_LLM_MODEL=qwen2.5:3b
CALENDAR_LLM_MODEL=qwen3.5:4b

# --- External Tooling & Observability ---
TAVILY_API_KEY=your_tavily_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=Moka-AI-Assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Optional Integrations ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
TODOIST_API_KEY=your_todoist_token_here
GROQ_API_KEY=your_groq_api_key_here
