# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cozmo_memory
DATABASE_URL=postgresql://postgres:your_secure_password_here@127.0.0.1:5432/cozmo_memory

# API Keys
TAVILY_API_KEY=your_tavily_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT="Moka-AI-Assistant"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Ollama & LLMs
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
ROUTER_LLM_MODEL=qwen2.5:3b
CHAT_LLM_MODEL=qwen2.5:3b
WEATHER_LLM_MODEL=qwen2.5:3b
CALENDAR_LLM_MODEL=qwen3.5:4b
JUDGE_LLM_MODEL=llama3.1
LLM_PROVIDER=OLLAMA
